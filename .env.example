# Local Supabase Postgres, connecting as the superuser -- used only for
# test fixtures and migrations, never by the running application.
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase Postgres, connecting as the dedicated non-owner app_user
# role -- this is what apps/api and the isolation test connect as. Never
# the service_role key; that bypasses row-level security entirely.
APP_DB_URL=postgres://app_user:introbuddy_local_dev_only@127.0.0.1:54322/postgres
DATABASE_URL=postgres://app_user:introbuddy_local_dev_only@127.0.0.1:54322/postgres

# apps/api: Supabase Auth (GoTrue). The anon key is used only to verify a
# password via signInWithPassword; the service_role key is used only to
# provision identities via the Admin API (create user, set password) --
# never to query public tables, that's always APP_DB_URL + withTenant.
# These are Supabase's well-known, published local-dev demo keys -- fixed
# for every local project, not secrets, and only valid against 127.0.0.1.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# apps/api: outbound email via generic SMTP (nodemailer). Points at local
# Supabase's Mailpit capture in dev -- switching to a real provider later
# (Resend, SES, ...) is an env-var change, not a code change.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM="IntroBuddy <noreply@introbuddy.local>"
WEB_APP_URL=http://127.0.0.1:3000
BREACHED_PASSWORD_CHECK_ENABLED=true
